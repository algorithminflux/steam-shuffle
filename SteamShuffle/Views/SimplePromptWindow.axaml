<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SteamShuffle.Views.SimplePromptWindow"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        CanResize="False">
    <StackPanel Margin="20">
        <TextBlock Name="PromptLabel" Margin="0,0,0,8" />
        <TextBox Name="ResponseBox" Margin="0,0,0,16" KeyDown="ResponseBox_KeyDown" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Classes="secondary" Click="Cancel_Click" />
            <Button Content="OK" Classes="primary" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
