<Window x:Class="SteamShuffle.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam Shuffle - Settings"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize">
    <StackPanel Margin="24" >
        <TextBlock Text="Connect your Steam account" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Text="Your key and ID are stored locally on this machine only." Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,20" TextWrapping="Wrap" />

        <TextBlock Text="Steam Web API Key" Margin="0,0,0,4" />
        <TextBox x:Name="ApiKeyBox" Margin="0,0,0,4" />
        <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,0,0,16" TextWrapping="Wrap">
            Get one free at steamcommunity.com/dev/apikey
        </TextBlock>

        <TextBlock Text="SteamID64" Margin="0,0,0,4" />
        <TextBox x:Name="SteamIdBox" Margin="0,0,0,4" />
        <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,0,0,16" TextWrapping="Wrap">
            Find yours at steamid.io by pasting your profile URL.
        </TextBlock>

        <TextBlock Text="Store currency / region code" Margin="0,0,0,4" />
        <TextBox x:Name="CountryCodeBox" Margin="0,0,0,4" Width="80" HorizontalAlignment="Left" />
        <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,0,0,20" TextWrapping="Wrap">
            "ca" for CAD pricing.
        </TextBlock>

        <TextBlock x:Name="ValidationText" Foreground="#E06C75" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
