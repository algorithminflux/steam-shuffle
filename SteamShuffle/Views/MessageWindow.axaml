<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SteamShuffle.Views.MessageWindow"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        CanResize="False">
    <StackPanel Margin="20">
        <TextBlock Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,16" />
        <Button Content="OK" Classes="primary" HorizontalAlignment="Right" Click="Ok_Click" />
    </StackPanel>
</Window>
