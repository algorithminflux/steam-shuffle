<Window x:Class="SteamShuffle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SteamShuffle.Controls"
        Title="Steam Shuffle" Height="780" Width="1080"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Collections" FontSize="20" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,12" />

            <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,12">
                <Button Content="+ New" Style="{StaticResource SecondaryButton}" Padding="10,6" Click="NewCollection_Click" Margin="0,0,6,0" />
                <Button Content="Manage" Style="{StaticResource SecondaryButton}" Padding="10,6" Click="ManageCollection_Click" />
            </StackPanel>

            <ListBox x:Name="CollectionsList" Grid.Row="2" SelectionChanged="CollectionsList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding AppIds.Count, StringFormat={}{0} games}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Content="Sync Library" Style="{StaticResource SecondaryButton}" Grid.Row="3" Margin="0,12,0,8" Click="Sync_Click" />
            <Button Content="Settings" Style="{StaticResource SecondaryButton}" Grid.Row="4" Click="Settings_Click" />
        </Grid>

        <!-- Main content -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="260" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <controls:SlotReelControl x:Name="Reel" Grid.Row="1" />

            <Button x:Name="SpinButton" Content="SPIN" Style="{StaticResource PrimaryButton}"
                    Grid.Row="2" FontSize="18" Padding="40,14" Margin="0,20,0,20"
                    HorizontalAlignment="Center" Click="Spin_Click" />

            <!-- Result card -->
            <Border x:Name="ResultCard" Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="10"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="20" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="6" ClipToBounds="True" Height="260" VerticalAlignment="Top">
                        <Image x:Name="ResultImage" Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <TextBlock x:Name="ResultTitle" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock x:Name="ResultSourceBadge" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,0,0,16" />

                        <UniformGrid Columns="2" Rows="2" Margin="0,0,0,16">
                            <StackPanel Margin="0,0,16,12">
                                <TextBlock Text="PRICE (CAD)" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <TextBlock x:Name="ResultPrice" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="GENRE" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <TextBlock x:Name="ResultGenre" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="PLAYTIME" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <TextBlock x:Name="ResultPlaytime" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="LAST PLAYED" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                <TextBlock x:Name="ResultLastPlayed" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="TAGS" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,0,0,6" />
                        <ItemsControl x:Name="ResultTags">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#232A36" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding}" FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
