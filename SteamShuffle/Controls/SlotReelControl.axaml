<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SteamShuffle.Controls.SlotReelControl"
             Height="340">

    <Border Background="#1B1F27" CornerRadius="10" BorderBrush="#3A4150" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Border Name="ReelClip" ClipToBounds="True">
                <Canvas Name="ReelCanvas" Height="320" HorizontalAlignment="Left">
                    <StackPanel Name="ReelStrip" Orientation="Horizontal" Canvas.Top="10" />
                </Canvas>
            </Border>

            <!-- Gradient fades on either edge so the reel feels like it scrolls into the frame -->
            <Rectangle IsHitTestVisible="False" Width="60" HorizontalAlignment="Left">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#1B1F27" Offset="0" />
                        <GradientStop Color="#001B1F27" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle IsHitTestVisible="False" Width="60" HorizontalAlignment="Right">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="100%,0%" EndPoint="0%,0%">
                        <GradientStop Color="#1B1F27" Offset="0" />
                        <GradientStop Color="#001B1F27" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Center pointer indicator -->
            <Path IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Top"
                  Fill="#FFD54A" Data="M 0,0 L 14,0 L 7,12 Z" Margin="0,-2,0,0" />
            <Path IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                  Fill="#FFD54A" Data="M 0,12 L 14,12 L 7,0 Z" Margin="0,0,0,-2" />
            <Rectangle IsHitTestVisible="False" HorizontalAlignment="Center" Width="2" Fill="#FFD54A" Opacity="0.5" />
        </Grid>
    </Border>
</UserControl>
